{
  "name": "react-webcam-kit",
  "version": "0.1.1",
  "description": "A modern React camera component and hooks toolkit for webcam preview, capture, and device control.",
  "license": "MIT",
  "author": "modeitsch",
  "homepage": "https://modeitsch.com/react-webcam-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modeitsch/react-webcam-kit.git"
  },
  "bugs": {
    "url": "https://github.com/modeitsch/react-webcam-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/API.md",
    "docs/assets/logo.svg",
    "docs/BROWSER-NOTES.md",
    "docs/RECIPES.md"
  ],
  "keywords": [
    "react",
    "webcam",
    "camera",
    "media",
    "getusermedia",
    "typescript",
    "hooks"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "dev": "vite --host 0.0.0.0",
    "site:build": "vite build --config vite.site.config.ts",
    "site:dev": "vite --config vite.site.config.ts --host 0.0.0.0",
    "site:preview": "vite preview --config vite.site.config.ts --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  }
}
