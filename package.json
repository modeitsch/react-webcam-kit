{
  "name": "react-webcam-kit",
  "version": "0.7.1",
  "description": "React webcam, screen recorder, and audio recorder hooks for camera preview, screenshots, recording, device switching, and media cleanup.",
  "license": "MIT",
  "author": "modeitsch",
  "homepage": "https://modeitsch.com/react-webcam-kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modeitsch/react-webcam-kit.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/modeitsch/react-webcam-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "llms.txt",
    "llms-full.txt",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/AI-USAGE.md",
    "docs/API.md",
    "docs/assets/logo.svg",
    "docs/BROWSER-NOTES.md",
    "docs/COMPARISON.md",
    "docs/COMPATIBILITY.md",
    "docs/MIGRATION.md",
    "docs/RELEASE.md",
    "docs/REACT-AUDIO-RECORDER.md",
    "docs/REACT-CAMERA-RECORDING.md",
    "docs/REACT-FRONT-BACK-CAMERA.md",
    "docs/REACT-QR-BARCODE-SCANNER.md",
    "docs/REACT-SCREEN-RECORDER.md",
    "docs/REACT-WEBCAM-CAPTURE.md",
    "docs/RECIPES.md"
  ],
  "keywords": [
    "react",
    "webcam",
    "camera",
    "camera-capture",
    "react-camera",
    "camera-hooks",
    "react-webcam",
    "webcam-react",
    "browser-camera",
    "camera-recording",
    "screen-recorder",
    "screen-recording",
    "react-screen-recorder",
    "audio-recorder",
    "react-audio-recorder",
    "react-qr-scanner",
    "barcode-scanner",
    "avatar-capture",
    "react-mediarecorder",
    "media",
    "mediarecorder",
    "getusermedia",
    "webrtc",
    "recording",
    "llms.txt",
    "typescript",
    "hooks"
  ],
  "scripts": {
    "build": "tsup",
    "browser:serve": "vite tests/browser --host 127.0.0.1 --port 4174",
    "clean": "rimraf dist coverage",
    "dev": "vite --host 0.0.0.0",
    "site:build": "vite build --config vite.site.config.ts",
    "site:dev": "vite --config vite.site.config.ts --host 0.0.0.0",
    "site:preview": "vite preview --config vite.site.config.ts --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "audit": "npm audit --audit-level=high",
    "package:check": "publint && attw --pack .",
    "size": "size-limit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:types": "tsc --project tests/consumer/tsconfig.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:browser && npm run build && npm run test:types && npm run package:check && npm run size",
    "prepublishOnly": "npm run verify"
  },
  "size-limit": [
    {
      "name": "ESM entry",
      "path": "dist/index.js",
      "limit": "18 KB"
    },
    {
      "name": "CommonJS entry",
      "path": "dist/index.cjs",
      "limit": "20 KB"
    }
  ],
  "peerDependencies": {
    "react": ">=18.0.0 || >=19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "publint": "^0.3.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
